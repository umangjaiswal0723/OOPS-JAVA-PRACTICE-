        System.out.print("Enter Employee Number: ");
        int empNo = sc.nextInt();

        sc.nextLine();

        System.out.print("Enter Employee Name: ");
        String empName = sc.nextLine();

        System.out.print("Enter Employee Basic Salary: ");
